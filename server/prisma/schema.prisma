// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum MemberRole {
  PLAYER
  COACH
  ADMIN
  ORGANIZER
}

model Member {
  id              Int       @id @default(autoincrement()) // Primary key - ensures unique IDs
  firstName       String
  lastName        String
  birthDate       DateTime? // Optional birth date for filtering and tournament selection
  isActive        Boolean   @default(true)
  emailConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // USATT-style rating (numeric rating like 1200, 1500, etc.)
  rating Int?

  // New required fields
  email    String?      @unique
  gender   Gender @default(NOT_SPECIFIED)
  password String
  roles    MemberRole[]

  // New optional fields
  picture String? // Image URL or path
  phone   String?
  address String?

  // Password reset flag
  mustResetPassword Boolean @default(false) // Set to true when admin resets password, forces password change on next login
  
  // Forgot password reset token
  passwordResetToken String? // Token for password reset (forgot password flow)
  passwordResetTokenExpiry DateTime? // Expiration time for reset token

  // One-time check-in code (sent via email, expires after 10 min)
  checkinCode       String?
  checkinCodeExpiry DateTime?

  // Segment for club plan pricing (e.g. "Regular", "Child", "Senior")
  segment String @default("Regular")

  // Credit applied to the next plan checkout (cents)
  purchaseCreditCents Int @default(0)

  // Auto-renew: persists until cleared; midnight job renews after prior-day expiry
  autoRenewEnabled   Boolean @default(false)
  autoRenewFamilyKey String?

  /**
   * Inclusive last club calendar day of free trial access (date-only, stored UTC noon).
   * Admin-only; while clubDate <= this day, check-in requires no plan and applies no charge.
   */
  trialEndsOn DateTime?

  /** Set when the post-trial notification email was sent (or skipped for no email). */
  trialExpiryNotifiedAt DateTime?

  /** Member must opt in (and have email) before online/automatic checkout is offered. */
  onlinePayConsent Boolean @default(false)

  // QR-based authentication token hash
  qrTokenHash String @unique

  // Permanent digit PIN for kiosk / public-terminal score confirmation (admin-visible)
  scorePin String

  /**
   * Auto-enter kiosk mode on login when the member has Organizer/Admin roles.
   * null = inherit SystemConfig.authPolicy.autoRelinquishPrivileges
   */
  autoRelinquishPrivileges Boolean?

  // Rating history
  ratingHistory RatingHistory[]

  // Tournament participations
  tournamentParticipants TournamentParticipant[]
  tournamentRegistrations TournamentRegistration[]

  // Tournament registration invitation opt-in. Existing users default to not subscribed.
  tournamentNotificationsEnabled Boolean @default(false)

  // Club check-in / payment relations
  clubVisits       ClubVisit[]
  clubEntitlements ClubEntitlement[]
  clubPayments     ClubPayment[]

  // Discount percentage for next plan purchase (0-100)
  clubDiscount     Int @default(0)

  /** When true, unpaid check-in cannot use courtesy grace. */
  courtesySuspended Boolean @default(false)

  @@index([email])
  @@map("members")
}

model RatingHistory {
  id           Int                @id @default(autoincrement())
  memberId     Int
  rating       Int? // Rating after this change
  ratingChange Int? // Change in rating (+/-)
  timestamp    DateTime           @default(now())
  reason       RatingChangeReason
  tournamentId Int? // Reference to tournament that caused this change
  matchId      Int? // Reference to match that caused this change (for MATCH_COMPLETED)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([timestamp])
  @@index([tournamentId])
  @@index([matchId])
  @@map("rating_history")
}

enum RatingChangeReason {
  TOURNAMENT_COMPLETED
  MATCH_COMPLETED
  RESULT_CORRECTED
  MANUAL_ADJUSTMENT
  INITIAL_RATING
}

// Tournament table: Contains information pertinent to ALL tournaments
// Basic tournaments: have players (TournamentParticipant) and matches (Match)
// Compound tournaments: consist of 2+ basic/compound tournaments (via parentTournamentId hierarchy)
// TournamentParticipants only exist for basic tournaments
model Tournament {
  id         Int              @id @default(autoincrement())
  name       String?          // Tournament name
  type       TournamentType   @default(ROUND_ROBIN)
  status     TournamentStatus @default(ACTIVE)
  cancelled  Boolean          @default(false) // True if tournament was cancelled
  createdAt  DateTime         @default(now())
  recordedAt DateTime         @updatedAt
  tournamentDate DateTime?
  registrationDeadline DateTime?
  minRating Int?
  maxRating Int?
  maxParticipants Int?
  minParticipants Int?
  /** When true, registration requires an EVENT payment (eventPriceCents). */
  isEvent Boolean @default(false)
  eventPriceCents Int?
  /** Minutes before tournamentDate when event check-in opens; null = system default. */
  eventCheckInLeadMinutes Int?
  /** Minutes before tournamentDate when event check-in closes; null = system default (0 = until start). */
  eventCheckInCloseMinutesBeforeStart Int?

  // Hierarchical structure: compound tournaments reference parent
  // If null, this is a root tournament (either basic or top-level compound)
  parentTournamentId Int?

  // Relations
  // Participants: only for basic tournaments (enforced at application level)
  participants   TournamentParticipant[]
  registrations  TournamentRegistration[]
  eventVisits    ClubVisit[]
  
  // Matches: only for basic tournaments (each match references one basic tournament)
  matches        Match[]
  
  // Bracket structure: only for PLAYOFF basic tournaments
  bracketMatches BracketMatch[]
  
  // Compound tournament configuration fields
  groupNumber          Int?     // For child tournaments: which group this is (1, 2, 3...)

  // Type-specific configuration (one-to-one relations)
  swissData                    SwissTournamentData?
  preliminaryConfig  PreliminaryConfig?

  // Self-referential relationship for parent-child tournaments (compound tournaments)
  parentTournament   Tournament?  @relation("TournamentHierarchy", fields: [parentTournamentId], references: [id], onDelete: Cascade)
  childTournaments   Tournament[] @relation("TournamentHierarchy")

  @@map("tournaments")
}

enum TournamentStatus {
  PRE_REGISTRATION
  ACTIVE
  COMPLETED
}

enum TournamentRegistrationStatus {
  INVITED
  PENDING
  REGISTERED
  DECLINED
}

model TournamentRegistration {
  id                   Int                          @id @default(autoincrement())
  tournamentId          Int
  memberId              Int
  registrationCodeHash  String                       @unique
  status                TournamentRegistrationStatus @default(INVITED)
  invitationSentAt      DateTime?
  registeredAt          DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  eventPaymentId        Int?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  eventPayment ClubPayment? @relation(fields: [eventPaymentId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, memberId])
  @@index([tournamentId])
  @@index([memberId])
  @@index([status])
  @@index([eventPaymentId])
  @@map("tournament_registrations")
}

// Tournament types: Basic tournaments have players and matches
// Compound tournaments consist of 2+ basic/compound tournaments
enum TournamentType {
  // Basic tournaments
  ROUND_ROBIN              // Round Robin tournament - no additional tables required
  PLAYOFF                  // Playoff tournament - uses BracketMatch table
  SWISS                    // Swiss tournament - uses SwissRound table (to be defined)
  
  // Compound tournaments
  MULTI_ROUND_ROBINS                  // Compound: multiple round robin tournaments
  PRELIMINARY_WITH_FINAL_PLAYOFF      // Compound: preliminary phase(s) + final playoff
  PRELIMINARY_WITH_FINAL_ROUND_ROBIN  // Compound: preliminary phase(s) + final round robin
}

// TournamentParticipants: identifies players playing in a basic tournament only
// Compound tournaments have no participants - participants are union of child tournaments
// Enforced at application level: only basic tournaments (ROUND_ROBIN, PLAYOFF, SWISS) have participants
model TournamentParticipant {
  id                 Int  @id @default(autoincrement())
  tournamentId       Int
  memberId           Int
  playerRatingAtTime Int? // Snapshot of rating when tournament started

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, memberId])
  @@index([tournamentId])
  @@index([memberId])
  @@map("tournament_participants")
}

// BracketMatch: Supporting table for PLAYOFF basic tournaments
// Stores the bracket layout for playoff tournaments
// Maintains bracket structure from start to finish, including unplayed matches
// References Match when both players are determined and match is created
model BracketMatch {
  id           Int      @id @default(autoincrement())
  tournamentId Int      // Foreign key to tournament (must be PLAYOFF basic tournament)
  round        Int      // Round number (1 = first round, 2 = semifinals, etc.)
  position     Int      // Position within the round (1, 2, 3, ...)
  member1Id    Int?     // Member 1 ID (null if not yet determined from previous round, 0 for BYE)
  member2Id    Int?     // Member 2 ID (null if not yet determined from previous round, 0 for BYE)
  nextMatchId  Int?     // ID of the BracketMatch in the next round that the winner advances to
  matchId      Int?     // Reference to Match when match is created (both players determined)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  nextMatch       BracketMatch?  @relation("BracketMatchAdvancement", fields: [nextMatchId], references: [id])
  previousMatches BracketMatch[] @relation("BracketMatchAdvancement")
  match           Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, position])
  @@unique([matchId]) // One BracketMatch per Match
  @@index([tournamentId])
  @@index([tournamentId, round, position])
  @@index([nextMatchId])
  @@index([matchId])
  @@map("bracket_matches")
}

// Match: stores actual match results for basic tournaments and standalone matches
// Each match references one basic tournament OR can be standalone (tournamentId = null)
// Matches are not tournaments - they record results played as part of a basic tournament
// BracketMatch references Match (via matchId) when match is created with both players determined
model Match {
  id             Int      @id @default(autoincrement())
  tournamentId   Int?     // Foreign key to basic tournament (ROUND_ROBIN, PLAYOFF, or SWISS) - null for standalone matches
  member1Id      Int
  member2Id      Int?     // Nullable for BYE matches
  player1Sets    Int      @default(0)
  player2Sets    Int      @default(0)
  player1Forfeit Boolean  @default(false)
  player2Forfeit Boolean  @default(false)
  notPlayed      Boolean  @default(false) // Early-complete NP: 0:0 with no W/L; correctable
  round          Int?     // Round number for Swiss tournaments (null for other types)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracketMatch BracketMatch? // Reverse relation: BracketMatch references this Match via matchId

  @@index([tournamentId])
  @@index([member1Id])
  @@index([member2Id])
  @@index([member1Id, member2Id])
  @@unique([tournamentId, member1Id, member2Id], map: "matches_tournament_pair_unique")
  @@map("matches")
}

model PointExchangeRule {
  id             Int      @id @default(autoincrement())
  minDiff        Int // Minimum rating difference (inclusive)
  maxDiff        Int // Maximum rating difference (inclusive)
  expectedPoints Int // Points for expected result (higher-rated player wins)
  upsetPoints    Int // Points for upset (lower-rated player wins)
  effectiveFrom  DateTime @default(now()) // When this rule becomes effective (allows future modifications)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([minDiff, maxDiff, effectiveFrom])
  @@index([effectiveFrom])
  @@map("point_exchange_rules")
}

model SystemConfig {
  id                String   @id @default("system")
  branding          Json     @default("{}")
  authPolicy        Json     @default("{}")
  preregistration   Json     @default("{}")
  ratingValidation  Json     @default("{}")
  tournamentRules   Json     @default("{}")
  clientRuntime     Json     @default("{}")
  clubPlans         Json     @default("{}")
  publicAccess      Json     @default("{}")
  payments          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("system_config")
}

// PreliminaryConfig: Configuration for compound preliminary tournaments
// Used by both PRELIMINARY_WITH_FINAL_ROUND_ROBIN and PRELIMINARY_WITH_FINAL_PLAYOFF
model PreliminaryConfig {
  id                     Int      @id @default(autoincrement())
  tournamentId           Int      @unique
  finalSize              Int      @default(0) // Size of the final phase (RR player count or playoff bracket size)
  autoQualifiedCount     Int      @default(0) // Number of auto-qualified players (highest rated, skip preliminary)
  autoQualifiedMemberIds Int[]    // Member IDs of auto-qualified players
  /** Playoff only: how many finishers from each prelim group qualify (default 1). */
  qualifiersPerGroup     Int      @default(1)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("preliminary_configs")
}

// ==============================
// CLUB CHECK-IN / PAYMENT SYSTEM
// ==============================

enum ClubPlanKind {
  TIME
  VISIT
}

enum ClubPlanDurationUnit {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

model ClubPlan {
  id            Int                   @id @default(autoincrement())
  familyKey     String                // Groups segment variants of the same offer
  name          String                // Display name shared by the family
  kind          ClubPlanKind
  segment       String                @default("Regular")
  priceCents    Int                   @default(0)
  currency      String                @default("USD")
  durationUnit  ClubPlanDurationUnit? // TIME only
  durationValue Int?                  // TIME only
  visitCount    Int?                  // VISIT only
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  entitlements ClubEntitlement[]

  @@unique([familyKey, segment])
  @@index([kind, isActive])
  @@index([familyKey, isActive])
  @@map("club_plans")
}

enum ClubVisitClosedBy {
  SCAN
  MANUAL
  AUTO
}

enum ClubEntitlementType {
  YEARLY
  MONTHLY
  VISIT_PACK
  PAY_PER_VISIT_EXTERNAL
}

enum ClubEntitlementStatus {
  CURRENT
  FUTURE
  ENDED
}

enum ClubPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ClubVisit: Records member check-in/check-out at the club
// Only the first visit of a club-local day triggers entitlement / payment logic
model ClubVisit {
  id                  Int                 @id @default(autoincrement())
  memberId            Int
  clubDate            String              // Club-local date "YYYY-MM-DD" (avoids timezone issues)
  checkInAt           DateTime            @default(now()) @map("checkedInAt")
  checkOutAt          DateTime?           @map("checkedOutAt")
  closedBy            ClubVisitClosedBy?  // How the visit was closed
  dailyPaymentApplied Boolean             @default(false) // True if this is the first visit of the day that debited entitlement
  isCourtesy          Boolean             @default(false)
  courtesyClearedAt   DateTime?
  obligationPaymentId Int?
  /** Set when check-in was refused (e.g. payment required); not a successful visit */
  rejectedAt          DateTime?
  rejectionReason     String?
  /** When set, this visit was covered by a paid/cleared tournament event (no club plan charge). */
  eventTournamentId   Int?
  /** Snapshot of why admission was granted (Trial / Plan (…) / Courtesy / event name). */
  admissionBasis      String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  member             Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  obligationPayment  ClubPayment? @relation("VisitObligationPayment", fields: [obligationPaymentId], references: [id], onDelete: SetNull)
  eventTournament    Tournament?  @relation(fields: [eventTournamentId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([clubDate])
  @@index([memberId, clubDate])
  @@index([isCourtesy, courtesyClearedAt])
  @@index([obligationPaymentId])
  @@index([rejectedAt])
  @@index([eventTournamentId])
  @@map("club_visits")
}

// ClubEntitlement: A purchased plan that grants club access
model ClubEntitlement {
  id              Int                     @id @default(autoincrement())
  memberId        Int
  type            ClubEntitlementType
  status          ClubEntitlementStatus   @default(CURRENT)
  label           String?
  validFrom       DateTime
  validTo         DateTime?               // For time-based plans
  visitsRemaining Int?                    // For VISIT_PACK: remaining visits
  visitsTotal     Int?                    // Snapshot at purchase (VISIT packs)
  amountPaidCents Int                     @default(0)
  familyKey       String?
  active          Boolean                 @default(true) // true for CURRENT/FUTURE
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Plan reference
  planId      Int?
  planSegment String? // Snapshot of member segment used at purchase

  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     ClubPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([memberId, status])
  @@index([planId])
  @@map("club_entitlements")
}

// ClubPayment: Ledger-only payment record (provider = plugin id string, e.g. "test", "manual")
model ClubPayment {
  id                 Int               @id @default(autoincrement())
  memberId           Int
  amountCents        Int               @default(0) // Cash/online charged (after credit)
  listAmountCents    Int               @default(0) // Plan/list price before credit
  creditAppliedCents Int               @default(0) // Purchase credit applied to this payment
  currency           String            @default("USD")
  provider           String            @default("manual")
  externalRef        String?
  status             ClubPaymentStatus
  purpose            String
  metadata           Json?
  recordedAt         DateTime          @default(now())

  member                 Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  courtesyVisits         ClubVisit[]              @relation("VisitObligationPayment")
  eventRegistrations     TournamentRegistration[]

  @@index([memberId])
  @@index([externalRef])
  @@index([status, provider])
  @@map("club_payments")
}

// SwissTournamentData: Configuration for SWISS tournaments
// Stores round count, pairing strategy, and completion state
model SwissTournamentData {
  id             Int      @id @default(autoincrement())
  tournamentId   Int      @unique
  numberOfRounds Int
  pairByRating   Boolean  @default(true)
  currentRound   Int      @default(0)
  isCompleted    Boolean  @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("swiss_tournament_data")
}
